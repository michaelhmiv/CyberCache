# GitHub Actions / iOS release config.
# Do not put real secret values in this file.

# Required for App Store Connect uploads and CI signing. The runner mints
# its own distribution certificate + provisioning profile through this API
# key (the PitTech ios-build pattern); no signing material is committed.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=

# App-specific values. Create these for CyberCache; do not copy PitTech values.
# ADMOB_APP_ID_IOS is passed to xcodebuild as the CYBERCACHE_ADMOB_APP_ID
# build setting, which Info.plist surfaces as GADApplicationIdentifier —
# the same env-with-sample-fallback seam ADMOB_APP_ID_ANDROID uses in
# android/app/build.gradle. Until the real iOS AdMob app exists, builds
# fall back to Google's public sample app ID committed in the Xcode project.
ADMOB_APP_ID_IOS=
# The iOS lanes pass the iOS rewarded unit IDs through the same VITE_*
# variables the Android lanes use (one build per platform, so the shared
# seam carries that platform's IDs — see src/lib/ads/).
ADMOB_REWARDED_CACHE_KEY_AD_UNIT_ID_IOS=
ADMOB_REWARDED_BENCH_TIME_AD_UNIT_ID_IOS=
VITE_GOOGLE_WEB_CLIENT_ID=

# Release metadata is normally generated by GitHub Actions.
MOBILE_VERSION_CODE=
MOBILE_VERSION_NAME=
