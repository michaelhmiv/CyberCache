{
  "name": "cybercache",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mechanics:validate": "vitest run src/test/mechanicsValidation.test.ts",
    "mechanics:report": "vitest run src/test/balanceReport.test.ts --reporter=verbose",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:bundle": "npm run android:sync && node scripts/run-gradle-wrapper.mjs bundleRelease",
    "start": "tsx --tsconfig tsconfig.server.json src/server/index.ts",
    "server": "tsx --tsconfig tsconfig.server.json src/server/index.ts",
    "postinstall": "node scripts/patch-capgo-social-login.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.22",
    "@supabase/supabase-js": "^2.108.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
