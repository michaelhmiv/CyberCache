# Route B (B4): the client talks only to the Chef. VITE_SUPABASE_* is
# gone from the client; the remaining server-side Supabase env belongs
# to the Chef process, not the web build.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_CHEF_URL=
VITE_APP_VERSION=local
VITE_DEBUG_SETTLEMENT=false
VITE_DEBUG_NATIVE_AUTH=false

# Android native rewarded ads. Keep test ads enabled locally unless you are
# validating real AdMob inventory in an approved release build.
VITE_ADMOB_REWARDED_CACHE_KEY_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917
VITE_ADMOB_TEST_ADS=true

# Product analytics (GA4 via Firebase Analytics). The four VITE_FIREBASE_*
# values are the Firebase console's WEB app config for project
# cybercache-29881 (Project settings → Your apps → Web app → SDK setup
# and configuration). Analytics stays completely OFF until all four are
# set — there is no placeholder. VITE_ANALYTICS_ENABLED=false forces
# collection off in any build; VITE_ANALYTICS_DEBUG=true (or a dev
# build, or ?analytics_debug=1 in the page URL) routes events to the
# GA4 DebugView for verification.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_ANALYTICS_ENABLED=
VITE_ANALYTICS_DEBUG=

