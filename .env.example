# Route B (B4): the client talks only to the Chef. VITE_SUPABASE_* is
# gone from the client; the remaining server-side Supabase env belongs
# to the Chef process, not the web build.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_CHEF_URL=
VITE_APP_VERSION=local
VITE_DEBUG_SETTLEMENT=false
VITE_DEBUG_NATIVE_AUTH=false

# Android native rewarded ads. Keep test ads enabled locally unless you are
# validating real AdMob inventory in an approved release build.
VITE_ADMOB_REWARDED_CACHE_KEY_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917
VITE_ADMOB_TEST_ADS=true

