# GitHub Actions / Android release config.
# Do not put real secret values in this file.

# Required for Play uploads and release signing.
PLAY_SERVICE_ACCOUNT_JSON=
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=cybercache-upload
ANDROID_KEY_PASSWORD=

# App-specific values. Create these for CyberCache; do not copy Sportfolio values.
ADMOB_APP_ID_ANDROID=
ADMOB_REWARDED_CACHE_KEY_AD_UNIT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=
GOOGLE_SERVICES_JSON=

# Release metadata is normally generated by GitHub Actions.
MOBILE_VERSION_CODE=
MOBILE_VERSION_NAME=
